{
  "name": "bpmn-mcp-editor",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Camunda 7 BPMN editor with a browser modeler and an MCP server for AI agents.",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "build": "vite build",
    "db:setup": "bun scripts/db.ts",
    "mcp": "bun src/server/stdio.ts",
    "test": "DATABASE_URL=file:../data/test.db bun scripts/db.ts && DATABASE_URL=file:../data/test.db bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "postinstall": "bun scripts/db.ts --generate-only"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@prisma/client": "6.19.3",
    "bpmn-auto-layout": "1.3.0",
    "bpmn-js": "18.31.0",
    "bpmn-js-properties-panel": "5.65.2",
    "bpmn-moddle": "10.3.1",
    "bpmnlint": "11.15.0",
    "bpmnlint-plugin-camunda-compat": "2.61.1",
    "camunda-bpmn-js-behaviors": "1.18.0",
    "camunda-bpmn-moddle": "8.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.4.0",
    "hono": "4.13.13",
    "lucide-react": "1.55.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
